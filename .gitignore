# ---- ultrasound-cobot: pose logs ----
# Runtime data (regenerable) — ignored.
#   pose_logger.py writes pose_logs/pose_log_<timestamp>.jsonl by default.
pose_logs/exec_*
pose_logs/pose_log_*.jsonl
pose_logs/replay_*.jsonl
pose_logger.jsonl

# Work products (irreplaceable) are intentionally NOT ignored and stay tracked:
#   pose_logs/sweep_teach_*.jsonl, pose_logs/shifted_*.jsonl,
#   and root-level sweep_teach*.jsonl / shifted_*.jsonl (the taught skills + launch files).

# python bytecode + OS cruft
__pycache__/
*.py[cod]
.DS_Store
